{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "white",
      "2": "white",
    },
    "padding": {
      "top": 2,
      "left": 2,
    },
  },
  "display": {
    "separator": " ",
    "percent": {
      "type": 1,
    },
  },
  "modules": [
    {
      "type": "custom",
      "format": "┌──────────────────────────────┐",
    },
    {
      "type": "host",
      "key": "│  ",
      "keyColor": "white",
    },
    {
      "type": "os",
      "key": "│  ",
      "keyColor": "white",
    },
    {
      "type": "kernel",
      "key": "│  ",
      "keyColor": "white",
    },
    {
      "type": "packages",
      "key": "│  ",
      "keyColor": "white",
    },
    {
      "type": "wm",
      "key": "│  ",
      "keyColor": "white",
    },
    {
      "type": "de",
      "key": "│  ",
      "keyColor": "white",
    },
    {
      "type": "shell",
      "key": "│  ",
      "keyColor": "white",
    },
    {
      "type": "terminal",
      "key": "│  ",
      "keyColor": "white",
    },
    {
      "type": "memory",
      "key": "│  ",
      "keyColor": "white",
    },
    {
      "type": "uptime",
      "key": "│  ",
      "keyColor": "white",
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────┘"
    },
  ],
}

